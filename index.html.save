<button>Estudar</button><!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>♡ Study Room AI ♡</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <div class="site">

        <header>
            <h1>♡ Study Room AI ♡</h1>
            <p>meu cantinho de estudos na internet</p>
        </header>

        <nav>
            <a href="index.html">🏠 início</a>
            <a href="#">📚 matérias</a>
            <a href="#">🤖 minha IA</a>
            <a href="#">📝 anotações</a>
            <a href="#">⏰ pomodoro</a>
        </nav>

        <main>

            <section class="welcome">
                <h2>♡ Olá, estudante!</h2>

                <p>
                    O que vamos estudar hoje?
                </p>

             <a href="paginas/ia.html">
    <button>🤖 Conversar com a IA</button>
</a>   
            </section>

            <section class="cards">

                <div class="card">
                    <h3>📚 Estudos</h3>
                    <p>Continue de onde você parou.</p>
                    <button>Estudar</button>
                </div>

                <div class="card">
                    <h3>🤖 IA</h3>
                    <p>Pergunte qualquer coisa sobre a matéria.</p>
                    <button>Conversar</button>
                </div>

                <div class="card">
                    <h3>📝 Anotações</h3>
                    <p>Guarde suas ideias e resumos.</p>
                    <button>Minhas notas</button>
                </div>

                <div class="card">
                    <h3>⏰ Pomodoro</h3>
                    <p>Estude com foco e faça pausas.</p>
                    <button>Começar</button>
                </div>

            </section>

        </main>

        <footer>
            <p>♡ feito com carinho para estudar ♡</p>
        </footer>

    </div>

    <script src="js/script.js"></script>

</body>
</html>
